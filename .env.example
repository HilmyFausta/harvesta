APP_NAME="{{APP_NAME}}"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Jakarta

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=harvesta
DB_USERNAME=postgres
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Tree photos (disk "photos"). Local development: keep PHOTO_DISK=local and run `php artisan storage:link`.
# Production (Supabase Storage, public bucket "harvesta-photos", see PRD 10):
#   PHOTO_DISK=s3
#   PHOTO_DISK_ROOT=photos
#   PHOTO_DISK_URL=https://<project-ref>.supabase.co/storage/v1/object/public/harvesta-photos
#   PHOTO_S3_ENDPOINT=https://<project-ref>.storage.supabase.co/storage/v1/s3
#   PHOTO_S3_REGION=<project region, e.g. ap-southeast-1>
#   PHOTO_S3_BUCKET=harvesta-photos
PHOTO_DISK=local
# PHOTO_DISK_ROOT=
# PHOTO_DISK_URL=
PHOTO_S3_ACCESS_KEY_ID=
PHOTO_S3_SECRET_ACCESS_KEY=
PHOTO_S3_REGION=auto
PHOTO_S3_BUCKET=
PHOTO_S3_ENDPOINT=
PHOTO_S3_USE_PATH_STYLE_ENDPOINT=true
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Seeded accounts. In production, set real values; the seeder refuses to run there with blank passwords.
SEED_ADMIN_NAME="Admin"
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=password
SEED_STAFF_NAME="Field Staff"
SEED_STAFF_EMAIL=staff@example.com
SEED_STAFF_PASSWORD=password
SEED_VIEWER_NAME="Guest Viewer"
SEED_VIEWER_EMAIL=viewer@example.com
SEED_VIEWER_PASSWORD=password
SEED_DEMO_DATA=true
